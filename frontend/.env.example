# local = demo-user picker + local API (no AWS). cognito = real sign-in.
VITE_AUTH_MODE=local
# Leave empty locally (Vite proxies /api). In AWS, scripts/deploy.sh fills these in.
VITE_API_BASE=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# Optional: your Slack workspace ID (T0123...) for deep links into Slack
VITE_SLACK_TEAM_ID=
